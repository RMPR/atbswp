# French translation of the atbswp GUI (crates/atbswp-gui).
# Strings are the @tr() literals in ui/app.slint; the build bundles this file.
msgid ""
msgstr ""
"Project-Id-Version: atbswp-gui\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Load macro"
msgstr "Charger une macro"

