msgstr "Gömülü oynatıcı yok: `make -C player` çalıştırıp yeniden derleyin veya ATBSWP_PLAYER ayarlayın"

msgid "atbswp settings"
msgstr "atbswp ayarları"

msgid "Play speed: fast (2×)"
msgstr "Oynatma hızı: hızlı (2×)"

msgid "Infinite playback"
msgstr "Sonsuz oynatma"

msgid "Repeat count"
msgstr "Tekrar sayısı"

msgid "Recording hotkey (stops recording)"
msgstr "Kayıt kısayolu (kaydı durdurur)"

msgid "Always on top"
msgstr "Her zaman üstte"

