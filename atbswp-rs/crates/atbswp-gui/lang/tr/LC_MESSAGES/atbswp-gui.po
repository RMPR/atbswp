# Turkish translation of the atbswp GUI (crates/atbswp-gui).
# Strings are the @tr() literals in ui/app.slint; the build bundles this file.
msgid ""
msgstr ""
"Project-Id-Version: atbswp-gui\n"
"Language: tr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Load macro"
msgstr "Makro yükle"

msgid "Save macro (standalone executable)"
msgstr "Makroyu kaydet (bağımsız çalıştırılabilir dosya)"

msgid "Stop recording"
msgstr "Kaydı durdur"

msgid "Record"
msgstr "Kaydet"

msgid "Stop"
msgstr "Durdur"

msgid "Play"
msgstr "Oynat"

msgid "Settings"
msgstr "Ayarlar"

msgid "Help (video tutorial)"
msgstr "Yardım (video eğitimi)"

msgid "Ready"
msgstr "Hazır"

msgid "{} events · {}s"
msgstr "{} olay · {}s"

msgid "Loaded {}"
msgstr "{} yüklendi"

msgid "Wrote {}"
msgstr "{} yazıldı"

