# Italian translation of the atbswp GUI (crates/atbswp-gui).
# Strings are the @tr() literals in ui/app.slint; the build bundles this file.
msgid ""
msgstr ""
"Project-Id-Version: atbswp-gui\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Load macro"
msgstr "Carica macro"

msgid "Save macro (standalone executable)"
msgstr "Salva macro (eseguibile autonomo)"

msgid "Stop recording"
msgstr "Ferma registrazione"

msgid "Record"
msgstr "Registra"

msgid "Stop"
msgstr "Ferma"

msgid "Play"
msgstr "Riproduci"

msgid "Settings"
msgstr "Impostazioni"

msgid "Help (video tutorial)"
msgstr "Aiuto (video tutorial)"

msgid "Ready"
msgstr "Pronto"

msgid "{} events · {}s"
msgstr "{} eventi · {}s"

msgid "Loaded {}"
msgstr "{} caricato"

msgid "Wrote {}"
msgstr "{} scritto"

msgid "Recording… press {} or the record button to stop"
msgstr "Registrazione… premi {} o il pulsante di registrazione per fermare"

