// atbswp main window: the classic one-row toolbar, plus a status line and
// playback settings.  Icons come from the original project.
import { Button, LineEdit, SpinBox, HorizontalBox, VerticalBox, CheckBox } from "std-widgets.slint";

component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    width: 72px;
    height: 72px;
    border-width: 1px;
    border-color: active ? #7ea7e7 : #d8d8d8;
    background: !enabled ? #f0f0f0 : active ? #dbe9ff : touch.has-hover ? #f4f4f4 : #ffffff;

    Image {
        source: root.icon;
        width: 40px;
        height: 40px;
        opacity: root.enabled ? 1 : 0.35;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    if touch.has-hover : Rectangle {
        y: parent.height - 2px;
        x: (parent.width - t.width - 8px) / 2;
        width: t.width + 8px;
        height: t.height + 4px;
        background: #333333;
        border-radius: 3px;
        t := Text { text: root.tooltip; color: white; font-size: 11px; x: 4px; y: 2px; }
    }
}

export component MainWindow inherits Window {
    title: "atbswp";
    icon: @image-url("../../../../atbswp/img/icon.png");
    default-font-size: 13px;
    min-width: 7 * 72px;

    in property <bool> recording: false;
    in property <bool> playing: false;
    in property <bool> busy: recording || playing;
    in property <string> status: "Ready";
    in property <int> event-count: 0;
    in property <float> duration-s: 0;
    in-out property <int> repeat: 1;
    in-out property <int> speed: 100;
    in-out property <bool> infinite: false;
    in-out property <bool> show-settings: false;
    background: #ffffff;

    callback load-clicked;
    callback save-clicked;
    callback record-toggled;
    callback play-toggled;
    callback compile-clicked;
    callback help-clicked;
    callback settings-changed;

    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            ToolButton { icon: @image-url("../../../../atbswp/img/file-upload.png"); tooltip: "Load capture"; enabled: !root.busy; clicked => { root.load-clicked(); } }
            ToolButton { icon: @image-url("../../../../atbswp/img/save.png"); tooltip: "Save macro (standalone executable)"; enabled: !root.busy && root.event-count > 0; clicked => { root.save-clicked(); } }
            ToolButton { icon: root.recording ? @image-url("../../../../atbswp/img/icon-recording.png") : @image-url("../../../../atbswp/img/video.png"); tooltip: root.recording ? "Stop recording" : "Record"; active: root.recording; enabled: !root.playing; clicked => { root.record-toggled(); } }
            ToolButton { icon: @image-url("../../../../atbswp/img/play-circle.png"); tooltip: root.playing ? "Stop" : "Play"; active: root.playing; enabled: !root.recording && (root.event-count > 0 || root.playing); clicked => { root.play-toggled(); } }
            ToolButton { icon: @image-url("../../../../atbswp/img/download.png"); tooltip: "Export as executable"; enabled: !root.busy && root.event-count > 0; clicked => { root.compile-clicked(); } }
            ToolButton { icon: @image-url("../../../../atbswp/img/cog.png"); tooltip: "Playback settings"; active: root.show-settings; clicked => { root.show-settings = !root.show-settings; } }
            ToolButton { icon: @image-url("../../../../atbswp/img/question-circle.png"); tooltip: "Help"; clicked => { root.help-clicked(); } }
        }
        if root.show-settings : VerticalBox {
            HorizontalBox {
                Text { text: "Repeat"; vertical-alignment: center; }
                SpinBox { minimum: 1; maximum: 100000; value <=> root.repeat; enabled: !root.infinite; edited => { root.settings-changed(); } }
                CheckBox { text: "forever"; checked <=> root.infinite; toggled => { root.settings-changed(); } }
                Text { text: "Speed %"; vertical-alignment: center; }
                SpinBox { minimum: 10; maximum: 2000; step-size: 10; value <=> root.speed; edited => { root.settings-changed(); } }
            }
        }
        Rectangle {
            height: 26px;
            background: root.recording ? #ffe3e3 : root.playing ? #e3f0ff : #f4f4f4;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                Text { text: root.status; vertical-alignment: center; overflow: elide; }
                Text {
                    text: root.event-count == 0 ? "" : "\{root.event-count} events · \{round(root.duration-s * 10) / 10}s";
                    vertical-alignment: center; horizontal-alignment: right; color: #555555;
                }
            }
        }
    }
}
